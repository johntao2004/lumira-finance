# ==============================================================================
# Lumira Finance Production Environment Configuration Template
# Package: finance@0.24.2
# ==============================================================================
# Copy this file to .env before starting containers:
#   cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# - NEVER commit real credentials, passwords, or .env files into version control.
# - Leave all secret values empty in templates; generate high-entropy random secrets
#   for production deployments using openssl or a secure secret manager.
# - LUMIRA_SECRET_KEYS must be backed up separately from PostgreSQL database dumps.
#   Loss of this key ring causes permanent data loss for all encrypted secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dedicated Finance Database Configuration
# ------------------------------------------------------------------------------
# Dedicated PostgreSQL database name and application user role.
# MUST contain 'finance' and NEVER 'lumira_next' to prevent database collisions.
LUMIRA_FINANCE_DB_NAME=lumira_finance
LUMIRA_FINANCE_DB_USER=lumira_finance_app

# Dedicated database user password.
# Generate with: openssl rand -base64 32
LUMIRA_DB_PASSWORD=

# ------------------------------------------------------------------------------
# 2. Host Binding & Ingress Edge Port
# ------------------------------------------------------------------------------
# Ingress edge proxy host IP bind interface.
# Default: 127.0.0.1 (listen on localhost behind system reverse proxy / Cloudflare / WAF)
LUMIRA_FINANCE_BIND_HOST=127.0.0.1

# Distinct ingress edge port.
# MUST NOT be 8010 or 8020 to prevent port collisions with upstream lumira-next.
LUMIRA_FINANCE_EDGE_PORT=8030

# ------------------------------------------------------------------------------
# 3. Dedicated Docker Proxy Network IPAM
# ------------------------------------------------------------------------------
# Isolated container proxy network subnet and pool (MUST NOT be 172.30.78.0/24).
# Allows coexistence on the same Docker host alongside upstream lumira-next.
LUMIRA_FINANCE_PROXY_SUBNET=172.30.79.0/24
LUMIRA_FINANCE_PROXY_POOL=172.30.79.128/25
LUMIRA_FINANCE_EDGE_ADDRESS=172.30.79.2

# ------------------------------------------------------------------------------
# 4. Security Credentials & Secret Encryption Key Ring
# ------------------------------------------------------------------------------
# Initial administrator bootstrap password (used only on first boot to seed the admin account).
# Generate with: openssl rand -base64 24
LUMIRA_BOOTSTRAP_PASSWORD=

# Dedicated Office worker shared secret authentication token.
# Generate with: openssl rand -base64 32
LUMIRA_OFFICE_WORKER_TOKEN=

# Application-level AES-256-GCM secret encryption key ring.
# Format: keyId=<base64-32-bytes>[,keyId2=<base64-32-bytes>]
# Example generation: primary=$(openssl rand -base64 32)
# CRITICAL: This key ring MUST be backed up separately from PostgreSQL database dumps!
# Encrypted tokens, MFA tickets, credentials, and settings cannot be recovered without it.
LUMIRA_SECRET_KEYS=

# Active key identifier in LUMIRA_SECRET_KEYS used for new cipher operations.
LUMIRA_SECRET_ACTIVE_KEY=primary

# Cookie Secure flag. Must be 'true' in production (HTTPS via edge reverse proxy).
# Set to 'false' only for local non-TLS HTTP testing.
LUMIRA_COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# 5. Plugin Runtime Governance
# ------------------------------------------------------------------------------
# Enforce approved immutable release plugin graph at startup.
# In production, this must remain 'true'.
# Set 'false' temporarily on a single maintenance node only during Day-1 empty-DB
# finance plugin installation or dynamic PRESERVE hot-upgrade, then lock back to 'true'!
LUMIRA_PLUGINS_FIXED_GRAPH=true

# ------------------------------------------------------------------------------
# 6. Observability & Data Retention
# ------------------------------------------------------------------------------
# Optional: bearer token (>=32 chars) enabling /actuator/prometheus on the private network.
# Leave blank to disable Prometheus scraping.
# Generate with: openssl rand -base64 32
LUMIRA_METRICS_TOKEN=

# Audit event retention window before automatic bounded-batch cleanup.
# Default: 365d (finance audit trail compliance)
LUMIRA_AUDIT_RETENTION=365d

# Outbox delivery log terminal state retention period before cleanup.
LUMIRA_DELIVERY_TERMINAL_RETENTION=30d
